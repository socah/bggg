# Production Compose config — non-secret values only, committed on purpose.
#
# Read by infra/ansible/roles/app_deploy/tasks/main.yml, which passes
# '--env-file .env.prod' to every 'docker compose ... up' invocation on the
# server. This is deliberately NOT the plain '.env' Compose auto-loads:
# that name stays git-ignored and hand-created per developer machine (see
# .env.example), so this file never collides with someone's local
# 'cp .env.example .env'.
#
# Secrets/PII that would normally live alongside these (KEYCLOAK_ADMIN_PASSWORD,
# KEYCLOAK_API_SERVICE_SECRET, LETSENCRYPT_EMAIL, AUTH_SECRET,
# AUTH_KEYCLOAK_SECRET, R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY)
# are NOT here — they're stored in Infisical's /ENV_VARS and injected as
# inline environment vars on the ansible-playbook run itself (same pattern
# as DB_PASSWORD/VAULT_KMS_*, see tasks/main.yml). LETSENCRYPT_EMAIL and
# R2_ENDPOINT aren't secrets the same way the others are (neither grants
# access on its own), but this file is committed on purpose — an email
# address or a Cloudflare account id (R2_ENDPOINT embeds one) has no
# business sitting in git history permanently on the chance this repo ever
# goes public.
# See notes/4_environments.md for the full reasoning.

# Must match the DuckDNS hostname actually pointed at this server (see
# infra/ansible/roles/duckdns) — Traefik's Host() router rules and Let's
# Encrypt's HTTP-01 challenge both depend on this exact value.
DOMAIN_NAME=bggg.duckdns.org

# Keycloak admin console bootstrap account — username only. The password
# half is a secret, supplied separately (see header above).
KEYCLOAK_ADMIN_USER=admin

# Must match infra/keycloak/boardgame-realm.json's realm name.
KEYCLOAK_REALM=boardgame

# Must match the 'clientId' of the service-account client in
# infra/keycloak/boardgame-realm.json. The secret half is a Keycloak-
# generated value, supplied separately (see header above).
KEYCLOAK_API_SERVICE_ID=api-service

# Cloudflare R2 — read by apps/api/src/uploads/r2.service.ts. Bucket name
# isn't sensitive on its own; the endpoint and access keys are, and live in
# Infisical instead (see header above). No public URL here at all — this
# bucket is private, photos are only ever served via a short-lived
# presigned GET URL (R2Service.createPresignedGetUrl), generated after
# checking the requester is actually a member of the relevant group. See
# notes/3_r2_uploads.md's Update section for why.
R2_BUCKET=bggg-prod

# Per-file upload cap and soft total-storage cap, in bytes. Same defaults
# as .env.example — pure config constants, not actually environment-
# specific, but kept configurable here rather than hardcoded in
# docker-compose.yml in case prod ever needs a different cap than dev.
MAX_UPLOAD_BYTES=10485760
R2_MAX_STORAGE_BYTES=10737418240
