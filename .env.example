# Board Game Group Platform — environment variable template
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.
# This file grows as services are added — each phase adds its section.

NODE_ENV=development

# Compose file layering — base image tags + dev overrides merged automatically.
# docker-compose.yml is the Dependabot-scannable base; docker-compose.dev.yml adds
# dev-specific config (credentials, ports, volumes). Setting COMPOSE_FILE here means
# plain 'docker compose up' picks up both without extra -f flags.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# PostgreSQL — used by docker-compose.dev.yml and the NestJS TypeORM connection
# DB_HOST: 'db' inside Docker Compose networking, 'localhost' when running NestJS outside Docker
DB_HOST=db
DB_PORT=5432
DB_USER=bggg
# No longer read by the 'db' container itself (see docker-compose.dev.yml —
# it now uses POSTGRES_PASSWORD_FILE, sourced from Vault via vault-agent).
# This value's only remaining job is seeding that same password into
# Vault's KV store, via the 'vault-bootstrap' service. NestJS's own DB
# connection still reads this var directly, same as before — see
# notes/3_vault.md for why the app side isn't wired through Vault yet.
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=bggg_dev

# Vault — dev-mode root token, shared by the 'vault-bootstrap' and
# 'vault-agent' services (see infra/vault/). Dev mode would otherwise
# generate a random token on every startup and print it to container logs;
# pinning one here means both services can reference the same known value.
# This value itself is exactly the kind of secret Vault exists to protect —
# acceptable only because dev mode's Vault has nothing persistent to
# protect once the container is removed. See notes/3_vault.md.
#
# Prod has no equivalent of this .env var at all: real Vault unseals via
# OCI KMS (infra/terraform/vault.tf), and vault-agent/vault-bootstrap
# authenticate via AppRole role_id/secret_id pairs instead of a shared
# root token — those are Ansible '-e' vars sourced from Infisical, not
# docker-compose ${...} substitutions. See notes/4_environments.md and
# infra/vault/bootstrap-prod-init.sh.
VAULT_DEV_ROOT_TOKEN=replace-with-a-strong-password

# Keycloak — admin console bootstrap account only (not an application user).
# Realm/client config itself lives in infra/keycloak/boardgame-realm.json, not here.
# Same var names in prod's .env, but with a real generated secret in place
# of this file's throwaway default — see notes/4_environments.md.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-password

# Read by apps/api's AuthGuard to build the JWKS and issuer URLs.
# KEYCLOAK_URL: 'http://keycloak:8080' inside Docker Compose networking,
# 'http://localhost:8080' when running NestJS outside Docker — same
# container-name-vs-localhost split as DB_HOST.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=boardgame

# Auth.js (apps/web) — env var names follow Auth.js's auto-detection
# convention for a provider with id "keycloak": AUTH_KEYCLOAK_ID,
# AUTH_KEYCLOAK_SECRET, AUTH_KEYCLOAK_ISSUER. apps/web/auth.ts never
# references these directly; Auth.js reads them by name at startup.
#
# AUTH_KEYCLOAK_SECRET has no value here on purpose: the 'web' client in
# infra/keycloak/boardgame-realm.json is confidential but deliberately has
# no "secret" field, so Keycloak generates a random one on first import
# instead of one being committed to git in plaintext. After 'docker compose
# up' the first time, copy it from the Keycloak admin console
# (Clients -> web -> Credentials tab) into your local .env.
AUTH_KEYCLOAK_ID=web
AUTH_KEYCLOAK_SECRET=
# Dev: reaches Keycloak's exposed port directly on the same machine the
# browser runs on. Prod's equivalent is
# 'https://<DOMAIN_NAME>/auth/realms/boardgame' — the browser is redirected
# here for login, so it has to be a real publicly-reachable URL, routed
# through Traefik's '/auth' PathPrefix router (docker-compose.yml) rather
# than Keycloak's own port, which prod never exposes at all. See
# notes/4_environments.md for why this couldn't just stay a bare exposed
# port the way dev's does.
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/boardgame

# Auth.js's own canonical origin — required in production, or every request
# is rejected with 'UntrustedHost' (reproduced directly: prod logs showed
# this for every single request before AUTH_URL was set). Bare origin, no
# path: apps/web/auth.ts already sets basePath explicitly ('/web/auth'), and
# a path here would just get discarded with a redundant warning logged (see
# createActionURL in @auth/core's own source). Prod's equivalent is
# 'https://<DOMAIN_NAME>' (docker-compose.yml's 'web' service).
AUTH_URL=http://localhost:3000

# Auth.js's own secret, unrelated to Keycloak — encrypts/signs the session
# cookie Auth.js issues to the browser. Any long random string works locally.
AUTH_SECRET=replace-with-a-strong-password

# Read by apps/api's KeycloakAdminClient to call Keycloak's Admin REST API
# (client_credentials grant) — this is what actually creates a Keycloak
# account when an invite is redeemed by someone new. See notes/3_invite_system.md
# Decision 4 for why registration itself had to move behind the invite system.
#
# Blank on purpose, same reasoning as AUTH_KEYCLOAK_SECRET above: the
# 'api-service' client in infra/keycloak/boardgame-realm.json has no
# "secret" field, so Keycloak generates one on import. Copy it from the
# admin console (Clients -> api-service -> Credentials tab) after first
# 'docker compose up'.
KEYCLOAK_API_SERVICE_ID=api-service
KEYCLOAK_API_SERVICE_SECRET=

# One-time bootstrap account, created by apps/api/scripts/seed-admin.ts via
# the same Admin API above — NOT used by the running application at all.
# Needed because registration is invite-only (see above): the very first
# person has no existing member to invite them, so this script creates
# exactly one account directly. Run once, then this account's owner invites
# everyone else from inside the app.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Cloudflare R2 (S3-compatible object storage) — read by apps/api's R2Service
# to generate presigned upload AND download URLs for play session photos.
# Credentials are only ever read server-side, never sent to the client. No
# public bucket URL: the bucket is private (photos should only be visible
# to a session's group, not to anyone with a link), so reads go through a
# short-lived presigned GET URL the same way uploads go through a
# presigned PUT — see notes/3_r2_uploads.md's Update section for the full
# reasoning.
#
# R2_ENDPOINT: per-account S3 API endpoint, from the Cloudflare dashboard
# (R2 -> Manage API Tokens): https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://replace-with-your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-a-strong-password
R2_SECRET_ACCESS_KEY=replace-with-a-strong-password
R2_BUCKET=bggg-dev

# Per-file upload cap, in bytes. Pinned into each presigned URL's signature
# (see R2Service.createPresignedUploadUrl) so R2 itself rejects a PUT whose
# real size doesn't match what was declared. Default below is 10 MiB.
MAX_UPLOAD_BYTES=10485760

# Soft cap on total bucket storage, in bytes, checked (approximately — see
# R2Service.hasCapacityFor) before every presign request. Default below
# matches R2's free tier (10 GiB) per design.md.
R2_MAX_STORAGE_BYTES=10737418240

# Traefik — read by the 'api'/'web' router labels in docker-compose.yml,
# not by any app code. Must match "<duckdns_domain>.duckdns.org", where
# duckdns_domain is infra/ansible/roles/duckdns's variable of the same name
# — Traefik's Host() rule and Let's Encrypt's HTTP-01 challenge both depend
# on that DuckDNS hostname already resolving to this machine.
DOMAIN_NAME=replace-with-your-subdomain.duckdns.org

# Let's Encrypt requires a contact email for expiry notices and to
# rate-limit-throttle by account, not for anything the app itself uses.
LETSENCRYPT_EMAIL=replace-with-your-email@example.com
