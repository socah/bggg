# Board Game Group Platform — environment variable template
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.
# This file grows as services are added — each phase adds its section.

NODE_ENV=development

# Compose file layering — base image tags + dev overrides merged automatically.
# docker-compose.yml is the Dependabot-scannable base; docker-compose.dev.yml adds
# dev-specific config (credentials, ports, volumes). Setting COMPOSE_FILE here means
# plain 'docker compose up' picks up both without extra -f flags.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# PostgreSQL — used by docker-compose.dev.yml and the NestJS DATABASE_URL (Phase 2)
DB_USER=bggg
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=bggg_dev
