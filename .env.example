# Board Game Group Platform — environment variable template
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.
# This file grows as services are added — each phase adds its section.

NODE_ENV=development

# Compose file layering — base image tags + dev overrides merged automatically.
# docker-compose.yml is the Dependabot-scannable base; docker-compose.dev.yml adds
# dev-specific config (credentials, ports, volumes). Setting COMPOSE_FILE here means
# plain 'docker compose up' picks up both without extra -f flags.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# PostgreSQL — used by docker-compose.dev.yml and the NestJS TypeORM connection
# DB_HOST: 'db' inside Docker Compose networking, 'localhost' when running NestJS outside Docker
DB_HOST=db
DB_PORT=5432
DB_USER=bggg
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=bggg_dev

# Keycloak — admin console bootstrap account only (not an application user).
# Realm/client config itself lives in infra/keycloak/boardgame-realm.json, not here.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-password

# Read by apps/api's AuthGuard to build the JWKS and issuer URLs.
# KEYCLOAK_URL: 'http://keycloak:8080' inside Docker Compose networking,
# 'http://localhost:8080' when running NestJS outside Docker — same
# container-name-vs-localhost split as DB_HOST.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=boardgame

# Auth.js (apps/web) — env var names follow Auth.js's auto-detection
# convention for a provider with id "keycloak": AUTH_KEYCLOAK_ID,
# AUTH_KEYCLOAK_SECRET, AUTH_KEYCLOAK_ISSUER. apps/web/auth.ts never
# references these directly; Auth.js reads them by name at startup.
#
# AUTH_KEYCLOAK_SECRET has no value here on purpose: the 'web' client in
# infra/keycloak/boardgame-realm.json is confidential but deliberately has
# no "secret" field, so Keycloak generates a random one on first import
# instead of one being committed to git in plaintext. After 'docker compose
# up' the first time, copy it from the Keycloak admin console
# (Clients -> web -> Credentials tab) into your local .env.
AUTH_KEYCLOAK_ID=web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/boardgame

# Auth.js's own secret, unrelated to Keycloak — encrypts/signs the session
# cookie Auth.js issues to the browser. Any long random string works locally.
AUTH_SECRET=replace-with-a-strong-password

# Cloudflare R2 (S3-compatible object storage) — read by apps/api's R2Service
# to generate presigned upload URLs for play session photos. Credentials are
# only ever read server-side, never sent to the client. See
# notes/3_r2_uploads.md for the full upload flow and why it's presigned-URL
# based rather than proxied through NestJS.
#
# R2_ENDPOINT: per-account S3 API endpoint, from the Cloudflare dashboard
# (R2 -> Manage API Tokens): https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://replace-with-your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-a-strong-password
R2_SECRET_ACCESS_KEY=replace-with-a-strong-password
R2_BUCKET=bggg-dev

# Public base URL photos are served from once uploaded — either R2's default
# public bucket URL or a custom domain mapped to the bucket. Used to build
# the URL stored in play_photos.url from an object key; never used for writes.
R2_PUBLIC_URL_BASE=https://replace-with-your-public-bucket-domain

# Per-file upload cap, in bytes. Pinned into each presigned URL's signature
# (see R2Service.createPresignedUploadUrl) so R2 itself rejects a PUT whose
# real size doesn't match what was declared. Default below is 10 MiB.
MAX_UPLOAD_BYTES=10485760

# Soft cap on total bucket storage, in bytes, checked (approximately — see
# R2Service.hasCapacityFor) before every presign request. Default below
# matches R2's free tier (10 GiB) per design.md.
R2_MAX_STORAGE_BYTES=10737418240
