{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // Next.js uses its own bundler (Turbopack/webpack) — tsc is only
    // used for type-checking, not for emitting JS files.
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // 'react-jsx' is mandatory under the App Router (Next.js's own build
    // step enforces this) — it emits React's automatic JSX runtime import
    // instead of requiring 'import React' in every file.
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      // '@/' is a shortcut so imports read 'import X from @/components/X'
      // instead of '../../components/X' — avoids brittle relative paths.
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
