{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "useESM": true,
      "tsconfig": {
        "module": "ESNext"
      }
    }]
  },
  "extensionsToTreatAsEsm": [".ts"],
  "setupFilesAfterEnv": ["<rootDir>/jest.setup.mjs"],
  "transformIgnorePatterns": ["node_modules/(?!(jose)/)"]
}
