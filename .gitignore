# Dependencies
node_modules/

# Build output
dist/
.next/
out/
# TypeScript's incremental build cache — machine/build-specific, regenerated
# on every compile, never meant to be shared via git.
*.tsbuildinfo
# Auto-generated by 'next dev'/'next build' — regenerated every time, not
# something to hand-edit or commit.
next-env.d.ts
# Auto-generated by next-pwa/workbox during 'next build' — regenerated on
# every build from next.config.ts's PWA options, not source.
apps/web/public/sw.js
apps/web/public/swe-worker-*.js
apps/web/public/workbox-*.js

# Environment files — real values never go in Git
.env
.env.local
.env.*.local
.env.production
.env.staging
# The template is the exception: it documents variables without leaking values
!.env.example
# Also an exception, but for a different reason: .env.prod holds only
# non-secret prod config (DOMAIN_NAME, LETSENCRYPT_EMAIL, etc.) — real
# secrets (KEYCLOAK_ADMIN_PASSWORD, KEYCLOAK_API_SERVICE_SECRET) never go
# in it, they come from Infisical via Ansible '-e' instead. See
# notes/4_environments.md. None of the patterns above actually match this
# filename anyway (no wildcard covers '.env.prod') — this line exists so
# that's true on purpose, not by accident.
!.env.prod

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/settings.json

# Terraform state — contains sensitive output values
infra/**/.terraform/
infra/**/terraform.tfstate
infra/**/terraform.tfstate.backup
infra/**/.terraform.lock.hcl

# Terraform variable files — contain real OCI/Cloudflare credentials
infra/**/terraform.tfvars
infra/**/*.auto.tfvars
!infra/**/terraform.tfvars.example

# Ansible inventory — generated from Terraform output by generate_inventory.sh,
# contains the real server IP and a local SSH key path
infra/ansible/inventory.ini
!infra/ansible/inventory.ini.example

# Logs
*.log
logs/
.dev/

# Git worktrees (superpowers SDD scratch workspaces)
.worktrees/
