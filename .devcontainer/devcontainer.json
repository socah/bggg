{
  "name": "bggg",

  // Microsoft's official Node 22 dev container image.
  // Includes: non-root 'node' user, git, curl, VS Code server support.
  // We use the image directly (no custom Dockerfile) until we need
  // system packages the base image doesn't provide.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",

  // Dev Container features: pre-packaged install scripts run after container start.
  // Docker-in-Docker lets us run 'docker compose' from the integrated terminal
  // without exposing the host Docker socket to the container.
  "features": {
    // set "moby" to false because image is based on Debian Trixie which does not support moby
    "ghcr.io/devcontainers/features/docker-in-docker:4": { "moby": false },
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/sliekens/devcontainer-features/ansible:1": {},
    // Lets infra/scripts/import-secrets.sh work right after the container is
    // created, with nothing installed by hand. No official devcontainers/
    // feature exists for this CLI, so this is a community one (same as the
    // ansible feature above).
    "ghcr.io/skriptfabrik/devcontainer-features/infisical-cli:1": {},
    // Installs the 'opencode' AI coding assistant CLI (pre-compiled binary
    // from GitHub releases into /usr/local/bin). The Superpowers plugin it
    // runs is wired up in the project-level opencode.json.
    "ghcr.io/devcontainer-community/devcontainer-features/opencode.ai:1": {}
  },

  // Extensions installed inside the container, not on the host.
  // They must run here because they depend on the container's Node and node_modules.
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "anthropic.claude-code"
      ]
    }
  },

  // 3000 — Next.js web app (the browser-facing UI)
  // 3001 — NestJS API (start with PORT=3001 npm run start:dev in apps/api)
  // 8080 — Keycloak: the OIDC login redirect sends the BROWSER to
  // AUTH_KEYCLOAK_ISSUER (localhost:8080) before any app code runs, so if
  // this port isn't forwarded the host browser dead-ends at the login step.
  // It must be listed explicitly: auto-detection can't see it, because the
  // listener belongs to Keycloak's container under Docker-in-Docker, not to
  // a process in this devcontainer.
  "forwardPorts": [3000, 3001, 8080],

  // Editor-independent port publishing (the spec's legacy mechanism): the
  // devcontainer CLI turns these into real 'docker -p' binds, which
  // infra/scripts/devcontainer-up.sh relies on — forwardPorts above does
  // nothing outside an editor, so without this a CLI-started container is
  // unreachable from the host browser. Loopback-only: nothing here should be
  // exposed to the network. VS Code ignores these when creating containers
  // and keeps using forwardPorts, so behavior there is unchanged.
  "appPort": [
    "127.0.0.1:3000:3000",
    "127.0.0.1:3001:3001",
    "127.0.0.1:8080:8080"
  ],

  // Runs once after the container is created and project files are mounted.
  // npm install is here (not in a Dockerfile) because it needs package.json,
  // which only exists in the mounted project — not inside the image.
  "postCreateCommand": "npm install",

  // Runs every time the container starts (every VS Code open or resume).
  // Syncs node_modules with the lockfile after a git pull without requiring
  // a manual npm install. npm install is a no-op when nothing has changed,
  // so the overhead on a clean start is negligible.
  "postStartCommand": "npm install"
}
